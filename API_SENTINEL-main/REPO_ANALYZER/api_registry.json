{
    "_about": "APIs that API Sentinel knows how to check. Adding an API = adding an entry here. spec_url must point at an OpenAPI (3.0 or 3.1) document in JSON or YAML. versioned_spec_url is optional: {version} is replaced with a version like 2022-11-28. Keys starting with _ are ignored.",

    "GitHub": {
        "hosts": ["api.github.com"],
        "spec_url": "https://raw.githubusercontent.com/github/rest-api-description/main/descriptions/api.github.com/api.github.com.json",
        "versioned_spec_url": "https://raw.githubusercontent.com/github/rest-api-description/main/descriptions/api.github.com/api.github.com.{version}.json",
        "format": "json",
        "version_header": "X-GitHub-Api-Version",
        "default_version": "2022-11-28",
        "known_versions": ["2022-11-28", "2026-03-10"],
        "docs_url": "https://docs.github.com/rest",
        "changelog_url": "https://docs.github.com/en/rest/about-the-rest-api/breaking-changes"
    },

    "OpenAI": {
        "hosts": ["api.openai.com"],
        "spec_url": "https://raw.githubusercontent.com/openai/openai-openapi/master/openapi.yaml",
        "format": "yaml",
        "version_header": null,
        "docs_url": "https://platform.openai.com/docs/api-reference",
        "changelog_url": "https://platform.openai.com/docs/changelog"
    }
}
